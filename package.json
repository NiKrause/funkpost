{
  "name": "@le-space/funkpost",
  "version": "0.1.0",
  "description": "Post über Funk: a byte courier for local-first apps over LoRa mesh radios — works with Meshtastic devices. Framing, selective-ACK ARQ, duty-cycle pacing; carries WebRTC handshakes and OrbitDB databases.",
  "type": "module",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NiKrause/funkpost.git"
  },
  "engines": {
    "node": ">=20"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./framing": "./lib/framing.js",
    "./pacing": "./lib/pacing.js",
    "./regions": "./lib/regions.js",
    "./courier": "./lib/meshtastic-courier.js",
    "./yjs": "./lib/yjs/provider.js",
    "./links/memory-mesh": "./lib/links/memory-mesh.js",
    "./links/meshtastic-device": "./lib/links/meshtastic-device-link.js",
    "./links/meshtastic-supervisor": "./lib/links/meshtastic-supervisor.js"
  },
  "scripts": {
    "test": "node --test --test-force-exit test/*.test.js",
    "bench:goodput": "node scripts/bench-goodput.js",
    "channel": "node scripts/make-channel.js"
  },
  "dependencies": {
    "@meshtastic/core": "^2.6.7",
    "@meshtastic/transport-web-bluetooth": "^0.1.5"
  },
  "peerDependencies": {
    "yjs": "^13.6.0"
  },
  "peerDependenciesMeta": {
    "yjs": {
      "optional": true
    }
  },
  "devDependencies": {
    "@bufbuild/protobuf": "^2.14.1",
    "@chainsafe/libp2p-noise": "^17.0.0",
    "@chainsafe/libp2p-yamux": "^8.0.1",
    "@libp2p/gossipsub": "^16.1.0",
    "@libp2p/identify": "^4.1.10",
    "@libp2p/tcp": "^11.0.28",
    "@meshtastic/transport-node": "^0.0.2",
    "@orbitdb/core": "^4.0.0",
    "blockstore-core": "^7.0.1",
    "datastore-core": "^12.0.1",
    "helia": "^7.1.12",
    "libp2p": "^3.3.6",
    "orbitdb-storacha-bridge": "^0.5.3",
    "yjs": "^13.6.27"
  },
  "workspaces": [
    "examples/*"
  ],
  "publishConfig": {
    "access": "public"
  }
}
